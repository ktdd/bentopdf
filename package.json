{
    "name": "bento-pdf",
    "private": true,
    "version": "2.8.11",
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "predev": "node scripts/generate-static-tool-links.mjs",
        "dev": "SIMPLE_MODE=true vite",
        "build": "node scripts/generate-static-tool-links.mjs && tsc && vite build && NODE_OPTIONS='--max-old-space-size=3072' node scripts/generate-sitemap.mjs && node scripts/generate-security-headers.mjs && node scripts/apply-indexing-policy.mjs && node scripts/compress-static-assets.mjs",
        "build:with-docs": "INCLUDE_DOCS=true npm run build && npm run docs:build && node scripts/compress-static-assets.mjs",
        "build:gzip": "COMPRESSION_MODE=g npm run build",
        "build:brotli": "COMPRESSION_MODE=b npm run build",
        "build:original": "COMPRESSION_MODE=o npm run build",
        "build:all": "COMPRESSION_MODE=all npm run build",
        "build:production": "VITE_USE_CDN=true npm run build:with-docs",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest watch",
        "build:docker": "vite build",
        "release": "node scripts/release.js patch",
        "release:minor": "node scripts/release.js minor",
        "release:major": "node scripts/release.js major",
        "serve:simple": "SIMPLE_MODE=true npm run build && npm run preview -- --port 3000",
        "serve": "npm run build && npm run preview -- --port 3000",
        "package": "node scripts/package-dist.js",
        "security:codeql": "codeql database create ./codeql-db --language=javascript-typescript --source-root=. --overwrite --threads=0 && codeql database analyze ./codeql-db --format=sarif-latest --output=codeql-results.sarif --threads=0 codeql/javascript-queries:codeql-suites/javascript-security-extended.qls",
        "security:codeql:quick": "codeql database analyze ./codeql-db --format=csv --output=codeql-results.csv --threads=0 codeql/javascript-queries:codeql-suites/javascript-security-extended.qls",
        "security:patterns": "node scripts/security-patterns-check.mjs",
        "security:audit": "npm audit --audit-level=high && npm run lint:security && npm run security:patterns"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/sortablejs": "^1.15.8",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "jsdom": "^28.1.0",
        "typescript": "~5.9.3",
        "vite": "^8.3.6",
        "vite-plugin-handlebars": "^2.0.0",
        "vite-plugin-node-polyfills": "^0.28.0",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@fontsource/dm-sans": "^5.2.8",
        "@mdit/plugin-abbr": "^1.1.3",
        "@mdit/plugin-anchor": "^2.2.3",
        "@mdit/plugin-dl": "^1.1.3",
        "@mdit/plugin-emoji": "^1.2.3",
        "@mdit/plugin-footnote": "^1.1.3",
        "@mdit/plugin-ins": "^2.1.3",
        "@mdit/plugin-katex-slim": "^1.1.4",
        "@mdit/plugin-mark": "^2.1.3",
        "@mdit/plugin-sub": "^1.1.3",
        "@mdit/plugin-sup": "^1.1.3",
        "@mdit/plugin-tasklist": "^1.1.4",
        "@neslinesli93/qpdf-wasm": "^0.3.0",
        "@phosphor-icons/web": "^2.1.2",
        "@tailwindcss/vite": "^4.2.1",
        "@types/papaparse": "^5.5.2",
        "archiver": "^7.0.1",
        "bentopdf-pdfium": "file:vendor/bentopdf-pdfium/bentopdf-pdfium-3f6b6114b166.tgz",
        "coherentpdf": "^2.5.5",
        "cropperjs": "^1.6.2",
        "dompurify": "^3.4.17",
        "heic2any": "^0.0.4",
        "highlight.js": "^11.12.0",
        "hyper-compress-wasm": "file:vendor/hyper-compress-wasm/hyper-compress-wasm-1.0.3.tgz",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.2",
        "jszip": "^3.10.1",
        "katex": "^0.19.1",
        "lucide": "^0.575.0",
        "markdown-it": "^15.0.3",
        "markdown-it-table-of-contents": "^1.2.0",
        "mermaid": "^12.2.0",
        "mupdf": "^1.28.6",
        "papaparse": "^5.5.3",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^5.4.624",
        "sortablejs": "^1.15.7",
        "tailwindcss": "^4.1.14"
    },
    "overrides": {
        "uuid": "^14",
        "node-forge": "^1.4.0",
        "flatted": "^3.4.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "lodash-es": "^4.18.1",
        "follow-redirects": "^1.15.11",
        "esbuild": "^0.25.0"
    }
}